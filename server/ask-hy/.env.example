# Ask HY V0.1 — server-only configuration
# Copy to the repository root as .env.local for local development, or use a
# systemd EnvironmentFile on the server. Never expose these values to Vite:
# client variables must start with VITE_ and this key must never do that.

# Required for live answers. Leave empty to exercise the explicit "unconfigured" state.
DEEPSEEK_API_KEY=

# Model is intentionally configurable. Check GET https://api.deepseek.com/models
# with the same key before changing it.
DEEPSEEK_MODEL=deepseek-v4-pro
# Optional: retry once with another model if the primary returns an empty answer.
DEEPSEEK_FALLBACK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Local API process. Keep it on loopback in production and reverse-proxy /api/ask-hy.
ASK_HY_HOST=127.0.0.1
ASK_HY_PORT=8787

# Browser origins allowed to call the API. In production list the exact origin.
# Local Vite origins are accepted automatically when NODE_ENV is not production.
ASK_HY_ALLOWED_ORIGINS=https://create.byheyang.cn
ASK_HY_ALLOWED_HOSTS=create.byheyang.cn,127.0.0.1,localhost

# Limits. These are per-IP / per-day request and token caps, not billing claims.
ASK_HY_RATE_MAX=12
ASK_HY_RATE_WINDOW_MS=600000
ASK_HY_DAILY_REQUESTS=300
ASK_HY_DAILY_TOKENS=200000
ASK_HY_MAX_CONCURRENT=4
ASK_HY_TIMEOUT_MS=25000
ASK_HY_MAX_INPUT_CHARS=600
ASK_HY_MAX_HISTORY=8
ASK_HY_MAX_TOKENS=1200
ASK_HY_TEMPERATURE=0.65
ASK_HY_MAX_BODY_BYTES=32768

# Set to 1 only behind Caddy with an overwritten X-Real-IP header.
ASK_HY_TRUST_PROXY=0

# Optional local demo mode. UI labels it DEMO and it never calls DeepSeek.
# ASK_HY_MOCK=1

# Optional pseudonymization salt for request logs. Set a random value on the server.
ASK_HY_LOG_SALT=
